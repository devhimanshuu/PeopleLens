# NestJS
NODE_ENV=development
PORT=3001

# Comma-separated allowlist of origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:3000

# PostgreSQL
# Required once Phase 2 introduces the data layer. Provision Postgres locally
# (or via your preferred tooling) and point DATABASE_URL at it.
DATABASE_URL=postgresql://peoplelens:peoplelens@localhost:5432/peoplelens?schema=public
