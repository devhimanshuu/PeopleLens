# ─────────────────────────────────────────────────────────────────────────────
# PeopleLens API — environment template
# Copy to `.env` and adjust. All variables are validated at boot (Joi) — the
# API refuses to start on missing/malformed values.
# ─────────────────────────────────────────────────────────────────────────────

# NestJS
NODE_ENV=development
PORT=3001

# Comma-separated allowlist of origins allowed to call the API with credentials.
#   CORS_ORIGINS=http://localhost:3000,https://app.example.com
CORS_ORIGINS=http://localhost:3000

# PostgreSQL (required)
# Connection string consumed by Prisma. Local dev: provision Postgres and point
# DATABASE_URL at it (see docker/docker-compose.yml). The API boots even when
# Postgres is unreachable — it logs a warning and continues until Phase 2 needs
# the data layer.
DATABASE_URL=postgresql://peoplelens:peoplelens@localhost:5432/peoplelens?schema=public

# Auth — JWT (architecture prepared; sign-in/sign-up endpoints land in Phase 2)
# NEVER ship the default secret to production.
JWT_SECRET=peoplelens-local-dev-secret-change-me
JWT_EXPIRES_IN=15m

# Developer tooling
SWAGGER_ENABLED=true
# Served under the global prefix: /api/v1/{SWAGGER_PATH}
SWAGGER_PATH=docs

# Request logging (one line per request)
REQUEST_LOGGING_ENABLED=true
